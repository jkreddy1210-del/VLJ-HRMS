# VLJ HRMS — Environment Configuration
# Copy this file to .env and fill in your values.

# PostgreSQL connection string for Prisma
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE"

# JWT (required for auth)
JWT_SECRET="replace-with-a-long-random-secret"
JWT_EXPIRES_IN="7d"

# Cloudinary
CLOUDINARY_CLOUD_NAME="your_cloud_name"
CLOUDINARY_API_KEY="your_api_key"
CLOUDINARY_API_SECRET="your_api_secret"

# Public app URL (used in password reset links)
APP_URL="https://hrms.varlakshmijewellery.co.in"

# Gmail SMTP — use a Google App Password
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="your-email@example.com"
SMTP_PASS="your-google-app-password"
SMTP_FROM="VLJ HRMS <your-email@example.com>"

# KENT CamAttendance webhook
# Use a random value of at least 32 characters.
# KENT can receive this through the webhook URL query parameter:
# https://hrms.varlakshmijewellery.co.in/api/attendance/kent?token=YOUR_TOKEN
KENT_ATTENDANCE_WEBHOOK_TOKEN="replace-with-a-long-random-secret"
